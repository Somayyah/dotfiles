# ── Streaming (OBS via obs-ws) ────────────────────────────────────────────

F1
    ~/.local/bin/stream_go_live.sh

F7
    ~/.local/bin/obs-ws mute 'Audio Input Capture (PulseAudio)'

F8
    ~/.local/bin/stream_lofi.sh

F9
    ~/.local/bin/obs-ws toggle-scene 'Live' 'BRB'

F12
    ~/.local/bin/stream_end.sh
